{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation/case.schema.json",
  "title": "hexmesh validation case",
  "description": "validation/<case>/case.json: a case's category, references, tags, status, gates and task (decision 0012, amendment 2026-10-30; task 0073).",
  "type": "object",
  "required": ["schemaVersion", "title", "category", "references", "tags", "status", "gates", "task"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "category": {
      "description": "The strongest reference: V1 exact solution, V2 high-fidelity simulation, V3 experiment, V4 correlation or standard.",
      "enum": ["V1", "V2", "V3", "V4"]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "role"],
        "additionalProperties": false,
        "properties": {
          "key": {"description": "Citation key in docs/references.bib; absent for an analytic solution derived in the case.", "type": "string"},
          "source": {"description": "What is compared: the solution, table or data set.", "type": "string", "minLength": 1},
          "role": {"enum": ["primary", "secondary"]}
        }
      }
    },
    "tags": {
      "type": "object",
      "required": ["regime", "physics", "features", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "regime": {
          "description": "Empty for solid conduction (no flow).",
          "type": "array",
          "items": {"type": "string", "pattern": "^(laminar|transient|transitional|rans:[A-Za-z0-9-]+)$"},
          "uniqueItems": true
        },
        "physics": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["flow", "cht", "conduction"]},
          "uniqueItems": true
        },
        "features": {
          "description": "The hexmesh features the case exercises (decision 0012's fixed list).",
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["section:circle", "section:rect", "layers", "straight", "bend",
                             "miter", "spline", "profiled-reducer", "transition", "tee",
                             "duct-tap", "wye", "stack-changes", "projection"]},
          "uniqueItems": true
        },
        "toolchain": {
          "description": "The solver: OpenFOAM, or FEniCSx for a secondary-solver case (decision 0034, task 0077).",
          "type": "object",
          "required": ["runner", "conversion"],
          "oneOf": [{"required": ["openfoam"]}, {"required": ["fenicsx"]}],
          "additionalProperties": false,
          "properties": {
            "openfoam": {"type": "string", "pattern": "^v[0-9]{4}$"},
            "fenicsx": {"type": "string", "pattern": "^dolfinx:v[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "runner": {"enum": ["native", "docker"]},
            "conversion": {"description": "How the mesh reaches OpenFOAM: gmshToFoam's flags, and any mesh made otherwise (task 0108).", "type": "string", "minLength": 1}
          }
        }
      }
    },
    "status": {"enum": ["planned", "in progress", "accepted", "rejected"]},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quantity", "limit"],
        "additionalProperties": false,
        "properties": {
          "quantity": {"type": "string", "minLength": 1},
          "limit": {"type": "string", "minLength": 1}
        }
      }
    },
    "task": {"type": "string", "pattern": "^[0-9]{4}$"},
    "notes": {
      "description": "Optional: a caveat a reader needs before trusting the comparison, e.g. a reference's known mismatch (task 0068).",
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "description": "Optional: the result in one line, for the README's validation table, e.g. \"reattachment 10.97 D vs the database's 11.03 D (−0.5 %)\"; its numbers from RESULTS.md (task 0078).",
      "type": "string",
      "minLength": 1
    }
  }
}
